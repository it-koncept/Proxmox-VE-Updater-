#!/bin/bash
# Mock pct for tests. Logs every call to $MOCK_CALLS.
# df -P calls (disk preflight): MOCK_GUEST_DF = free KB (default 50 GB),
#   MOCK_GUEST_DF_FAIL_VMS = vmids whose df fails.
# Other exec calls: MOCK_PCT_FAIL_VMS = vmids returning rc=100.
# MOCK_PCT_HANG=1: sleep (to exercise timeout handling).
echo "pct $*" >> "$MOCK_CALLS"
if [ "${1:-}" = "exec" ]; then
    vmid="${2:-}"
    if printf '%s' "$*" | grep -q "df -P"; then
        if printf '%s' ",${MOCK_GUEST_DF_FAIL_VMS:-}," | grep -q ",$vmid,"; then
            echo "df: no such file (mock)" >&2
            exit 1
        fi
        printf 'Filesystem 1024-blocks Used Available Capacity Mounted\n/dev/sda1 1000000 100 %s 91%% /\n' "${MOCK_GUEST_DF:-50000000}"
        exit 0
    fi
    if [ "${MOCK_PCT_HANG:-0}" = "1" ]; then
        sleep 10
    fi
    # v3.5 scan commands (read-only): apt-get -s upgrade / check-update
    if printf '%s' "$*" | grep -q "apt-get -s upgrade"; then
        case "${MOCK_PCT_SCAN_MODE:-updates}" in
            current) echo "Reading state information... 0 upgraded, 0 newly installed"; exit 0 ;;
            fail)    echo "E: scan failed (mock)" >&2; exit 100 ;;
        esac
        printf 'Inst mockpkg1 [1.0] (1.1 mock)\nInst mockpkg2 [2.0] (2.1 mock)\n2 upgraded\n'
        exit 0
    fi
    if printf '%s' "$*" | grep -q "check-update"; then
        case "${MOCK_PCT_YUM_SCAN:-available}" in
            current) exit 0 ;;
            fail)    echo "Error: check-update failed (mock)" >&2; exit 1 ;;
        esac
        printf 'mockpkg1.x86_64    1.1-1.el8    mockrepo\nmockpkg2.x86_64    2.1-1.el8    mockrepo\n'
        exit 100
    fi
    if printf '%s' ",${MOCK_PCT_FAIL_VMS:-}," | grep -q ",$vmid,"; then
        echo "E: apt-get update failed (mock)" >&2
        exit 100
    fi
fi
exit 0
