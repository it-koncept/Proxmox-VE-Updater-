#!/bin/bash
# Mock pct for tests. Logs every call to $MOCK_CALLS.
# MOCK_PCT_FAIL_VMS: comma-separated VMIDs whose exec returns rc=100.
# MOCK_PCT_HANG=1: sleep (to exercise timeout handling).
echo "pct $*" >> "$MOCK_CALLS"
if [ "${1:-}" = "exec" ]; then
    vmid="${2:-}"
    if [ "${MOCK_PCT_HANG:-0}" = "1" ]; then
        sleep 10
    fi
    if printf '%s' ",${MOCK_PCT_FAIL_VMS:-}," | grep -q ",$vmid,"; then
        echo "E: apt-get update failed (mock)" >&2
        exit 100
    fi
fi
exit 0
