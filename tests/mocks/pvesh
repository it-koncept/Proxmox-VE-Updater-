#!/bin/bash
# Mock pvesh for tests. Logs every call to $MOCK_CALLS and serves fixtures.
# Never touches the real system.
echo "pvesh $*" >> "$MOCK_CALLS"
case "$*" in
    *"/agent"*)
        # path form: /nodes/<node>/qemu/<vmid>/agent
        vmid=$(printf '%s' "$*" | sed -n 's|.*/qemu/\([0-9][0-9]*\)/agent.*|\1|p')
        if printf '%s' ",${MOCK_QM_AGENT_DOWN_VMS:-}," | grep -q ",$vmid,"; then
            echo "QEMU guest agent is not running" >&2
            exit 255
        fi
        echo '{"status":"ok"}'
        ;;
    *cluster/backup*)
        if [ "${MOCK_BACKUP_FAIL:-0}" = "1" ]; then
            echo "pvesh: backup job list failed (mock)" >&2
            exit 255
        fi
        cat "${MOCK_BACKUP_FIXTURE:-$MOCK_FIXTURES/jobs_all.json}"
        ;;
    *cluster/resources*)
        if [ "${MOCK_PVESH_FAIL:-0}" = "1" ]; then
            echo "pvesh: command failed (mock)" >&2
            exit 255
        fi
        if [ "${MOCK_PVESH_GARBAGE:-0}" = "1" ]; then
            echo "not json at all"
            exit 0
        fi
        cat "${MOCK_PVESH_FIXTURE:-$MOCK_FIXTURES/resources_basic.json}"
        ;;
    *)
        exit 0
        ;;
esac
