# Example environment file for update-vms.service.
# Install to /etc/default/update-vms and adjust.
#
# PVU_OPTIONS is split on whitespace by systemd (no shell quoting).
# SAFE DEFAULT: dry-run only. Switch to a real run deliberately:
#   PVU_OPTIONS=--report /var/log/update-vms/report.json --log-file /var/log/update-vms/run.log
#
# Never add --host to a timer-driven run without an explicit policy
# decision: host dist-upgrades need interactive confirmation (SEC-001).
PVU_OPTIONS=--dry-run

# Optional tuning (see README):
#MIN_GUEST_FREE_MB=500
#PCT_EXEC_TIMEOUT=1800
#QEMU_EXEC_TIMEOUT=1800
